{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "better-iptv-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "better-iptv",
      "database_id": "5829598e-d3b5-4767-8593-69239a9d8923",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "TMDB_API": "https://api.themoviedb.org/3",
    "NETFLIX_TOP10": "https://www.netflix.com/tudum/top10/data",
    "OPENSUBTITLES_API": "https://api.opensubtitles.com/api/v1",
    "OPENSUBTITLES_USER_AGENT": "BetterIPTV v1",
    "SUBDL_API": "https://api.subdl.com/api/v1",
    "SUBDL_DOWNLOADS": "https://dl.subdl.com"
  }
  // Secrets, set with `wrangler secret put`: TMDB_TOKEN (TMDB's API read access token), and for subtitles
  // OPENSUBTITLES_API_KEY, OPENSUBTITLES_USERNAME, OPENSUBTITLES_PASSWORD and SUBDL_API_KEY.
}
