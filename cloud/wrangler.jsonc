{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "better-iptv-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Reads ESPN's scoreboard for /v1/games and Wikipedia's pageviews for /v1/trending, which only read D1 (#252, #477).
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "better-iptv",
      "database_id": "5829598e-d3b5-4767-8593-69239a9d8923",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ESPN_API": "https://site.api.espn.com/apis/site/v2/sports",
    "WIKIDATA_SPARQL": "https://query.wikidata.org/sparql",
    "WIKIMEDIA_PAGEVIEWS": "https://wikimedia.org/api/rest_v1/metrics/pageviews",
    "OPENSUBTITLES_API": "https://api.opensubtitles.com/api/v1",
    "OPENSUBTITLES_USER_AGENT": "BetterIPTV v1",
    "SUBDL_API": "https://api.subdl.com/api/v1",
    "SUBDL_DOWNLOADS": "https://dl.subdl.com",
    // The sign-in emails' sender (README, Accounts). SITE_URL and EMAIL_FROM go here once the app's domain is set up.
    "RESEND_API": "https://api.resend.com"
  }
  // Secrets, set with `wrangler secret put`: for subtitles OPENSUBTITLES_API_KEY, OPENSUBTITLES_USERNAME, OPENSUBTITLES_PASSWORD and SUBDL_API_KEY,
  // and for sign-in emails RESEND_API_KEY.
}
